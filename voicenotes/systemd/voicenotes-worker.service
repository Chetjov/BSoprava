# Uživatelská unit na notebooku: ~/.config/systemd/user/voicenotes-worker.service
# Uživatelská proto, že vault i SSH klíč jsou v $HOME.
[Unit]
Description=voicenotes worker (jeden průchod fronty)
Documentation=https://github.com/chetjov/BSoprava/tree/main/voicenotes
After=network-online.target

[Service]
Type=oneshot
Environment=VOICENOTES_CONFIG=%h/.config/voicenotes/config.yaml
ExecStart=%h/.local/share/voicenotes/venv/bin/voicenotes-worker
# Prázdná fronta i vypnuté Pi končí nulou — v žurnálu nic nesvítí.
# Délka nahrávek je proměnná a po víkendu může fronta obsahovat desítky minut
# zvuku; useknout worker uprostřed je horší než ho nechat doběhnout.
TimeoutStartSec=2h
