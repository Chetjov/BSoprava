# ~/.config/systemd/user/voicenotes-review.timer
# systemctl --user enable --now voicenotes-review.timer
[Unit]
Description=Týdenní review inboxu

[Timer]
# Pondělí ráno — přehled čeká, až se sedne k počítači.
OnCalendar=Mon 09:00
# Doběhne, i když byl notebook v pondělí vypnutý.
Persistent=true
RandomizedDelaySec=5min
Unit=voicenotes-review.service

[Install]
WantedBy=timers.target
